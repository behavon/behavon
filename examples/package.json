{
  "name": "behavon-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Use-case examples built on the public behavon package",
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"**/*.ts\" \"**/*.tsx\"",
    "test": "npm run typecheck && npm run lint && vitest run",
    "demo": "vite --config demo/vite.config.ts"
  },
  "dependencies": {
    "behavon": "file:..",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "29.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
