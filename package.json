{
  "name": "behavon",
  "version": "0.1.0",
  "description": "React-like model hooks with Signal, Slot, and typed snapshot identities",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/index.d.ts.map",
    "eslint.behavon-hooks.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build": "npm run build:lib",
    "lint:hooks": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.tsx\"",
    "check:hooks": "npm run lint:hooks && npm run test:lint:hooks",
    "test": "npm run docs:examples && npm run typecheck && npm run check:hooks && vitest run && npm run test:types:package",
    "docs:examples": "node scripts/extract-doc-examples.mjs",
    "test:docs": "npm run docs:examples && npm run typecheck && eslint \"tests/docs/**/*.ts\" \"tests/docs/**/*.tsx\" && vitest run tests/docs",
    "test:lint:hooks": "node scripts/verify-hook-authoring.mjs",
    "test:types:package": "npm run build:lib && npm run verify:types:package",
    "verify:types:package": "tsc -p tests/types/package-consumer/tsconfig.json && tsc -p tests/types/package-consumer/tsconfig.verify.json",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-typescript": "^7.29.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.2.1",
    "jsdom": "29.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
